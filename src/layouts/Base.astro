---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Which nav item to mark as current. */
  section?: 'home' | 'projects' | 'blog' | 'privacy';
}

const { title, description, section = 'home' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

// GA4 measurement ID. It ships in the page source on every site that uses it,
// so there is nothing to hide and nothing to configure at deploy time.
const GA_ID = 'G-G1SQ98TEYH';
const GA_HOST = 'grandseafox.github.io';

const nav = [
  { href: '/', label: 'Home', key: 'home' },
  { href: '/projects/', label: 'Projects', key: 'projects' },
  { href: '/blog/', label: 'Blog', key: 'blog' },
  { href: '/privacy/', label: 'Privacy', key: 'privacy' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Gonçalo Raposeiro" href="/rss.xml" />

    <!-- Sized ahead of time from images/favicon-source.png rather than shipping
         one large PNG for the browser to shrink. 64 is there for retina tabs.
         Files live in public/, so they are served as-is. -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon-64.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Set the theme before first paint so the page never flashes the wrong ground. -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          if (stored === 'dark' || stored === 'light') {
            document.documentElement.dataset.theme = stored;
          }
        } catch (e) { /* private mode, fall back to the OS preference */ }
      })();
    </script>

    {import.meta.env.PROD && (
      <script is:inline define:vars={{ GA_ID, GA_HOST }}>
        // Dev builds never emit this, but `astro preview` does, so the hostname
        // check keeps local previews out of the real property. Loading gtag
        // from inside the check means anywhere else makes no request at all.
        if (location.hostname === GA_HOST) {
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
          document.head.appendChild(s);

          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', GA_ID);
        }
      </script>
    )}
  </head>

  <body>
    <header class="masthead">
      <div class="wrap">
        <a class="sig" href="/" style="text-decoration:none">GONÇALO RAPOSEIRO <span>/ engineer</span></a>
        <nav class="nav" aria-label="Main">
          {nav.map((item) => (
            <a href={item.href} aria-current={item.key === section ? 'page' : undefined}>{item.label}</a>
          ))}
          <button type="button" id="theme-toggle" class="theme-toggle" aria-label="Switch colour theme" title="Switch colour theme">
            <svg class="sun" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4.2" />
              <path d="M12 2.4v2.3M12 19.3v2.3M4.2 12H1.9M22.1 12h-2.3M6.5 6.5 4.9 4.9M19.1 19.1l-1.6-1.6M17.5 6.5l1.6-1.6M4.9 19.1l1.6-1.6" />
            </svg>
            <svg class="moon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20.5 14.6A8.6 8.6 0 0 1 9.4 3.5a8.6 8.6 0 1 0 11.1 11.1Z" />
            </svg>
          </button>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <div class="wrap">
        <span class="small">© {new Date().getFullYear()} Gonçalo Raposeiro</span>
        <span>
          <a href="mailto:goncalo.raposeiro@outlook.com">Email</a> ·
          <a href="https://github.com/grandSeaFox" rel="me noopener" target="_blank">GitHub</a> ·
          <a href="https://www.linkedin.com/in/goncalo-raposeiro/" rel="me noopener" target="_blank">LinkedIn</a> ·
          <a href="/rss.xml">RSS</a>
        </span>
      </div>
    </footer>

    <script is:inline>
      document.getElementById('theme-toggle')?.addEventListener('click', function () {
        var root = document.documentElement;
        var isDark = root.dataset.theme
          ? root.dataset.theme === 'dark'
          : window.matchMedia('(prefers-color-scheme: dark)').matches;
        var next = isDark ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch (e) { /* ignore */ }
      });
    </script>
  </body>
</html>
