---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', (p) => !p.data.draft);
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={`${post.data.title} | Gonçalo Raposeiro`} description={post.data.summary} section="blog">
  <article class="band">
    <div class="wrap row">
      <div class="label">
        <div>{post.data.date.toISOString().slice(0, 10)}</div>
        {post.data.tags.length > 0 && <div style="margin-top:0.4rem">{post.data.tags.join(' · ')}</div>}
      </div>
      <div>
        <h2>{post.data.title}</h2>
        <p class="lede">{post.data.summary}</p>
        <div class="prose" style="margin-top:1.5rem"><Content /></div>
      </div>
    </div>
  </article>
</Base>
