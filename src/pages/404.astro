---
import Base from '../layouts/Base.astro';
---

<Base title="Not found | Gonçalo Raposeiro" description="That page does not exist.">
  <section class="band">
    <div class="wrap row">
      <div class="label">404</div>
      <div>
        <h2>That page doesn't exist</h2>
        <p>The link may be old, or I may have moved something. Try the <a href="/">home page</a>,
          the <a href="/projects/">projects</a>, or the <a href="/blog/">blog</a>.</p>
      </div>
    </div>
  </section>
</Base>
