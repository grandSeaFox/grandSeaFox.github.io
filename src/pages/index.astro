---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectList from '../components/ProjectList.astro';
import Timeline from '../components/Timeline.astro';

const projects = (await getCollection('projects', (p) => !p.data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const featured = projects.filter((p) => p.data.featured);
const rest = projects.filter((p) => !p.data.featured);

const posts = (await getCollection('blog', (p) => !p.data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const oss = [
  { repo: 'react_virtualized_timeline', blurb: 'Virtualised timeline component' },
  { repo: 'react-magic-dropdown-button', blurb: 'Dropdown button component' },
  { repo: 'performance_test_bun_hono-node_express', blurb: 'Bun + Hono vs Node + Express' },
  { repo: 'nextjs-14-onboarding', blurb: 'Next.js 14 walkthrough' },
];
---

<Base
  title="Gonçalo Raposeiro — Software Engineer"
  description="Senior Software Engineer in Lisbon. Co-founder of Better Beta. Wrote a Game Boy Advance emulator from scratch in Rust."
  section="home"
>
  <section class="band">
    <div class="wrap" style="padding-block: clamp(3rem, 9vw, 6rem)">
      <div class="label">Lisbon, Portugal</div>
      <h1 style="font-size: clamp(1.9rem, 5.2vw, 3.1rem); letter-spacing: -0.03em; margin: 0.9rem 0 1.1rem">
        Most days I'm finding where the funnel leaks.
        <span style="color: var(--accent)">Most nights I'm making a 2001 handheld boot on a Pixel.</span>
      </h1>
      <p class="lede">
        Senior Software Engineer at Park, where I take features from design to deployment across
        React, Rails and TypeScript, and run the analytics and A/B tests that say whether they
        worked. Co-founder of Better Beta. On my own time I wrote a Game Boy Advance emulator in Rust.
      </p>
      <div class="facts">
        <span><b>9 yrs</b> shipping</span>
        <span><b>Rust</b> · <b>TypeScript</b> · <b>Ruby</b> · <b>Swift</b></span>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap row">
      <div class="label"><span class="idx">01</span> — Selected work</div>
      <div>
        <h2>Projects</h2>
        <p class="small">
          Most of these repositories are private, so each entry links to a case study here rather
          than a GitHub 404.
        </p>
        <ProjectList projects={featured} />
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap row">
      <div class="label"><span class="idx">02</span> — Also built</div>
      <div>
        <ProjectList projects={rest} />
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap row">
      <div class="label"><span class="idx">03</span> — Timeline</div>
      <div>
        <h2>Nine years, in order</h2>
        <p class="small">
          Jobs, education and projects share one spine, because they happened at the same time.
        </p>
        <Timeline />
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap row">
      <div class="label"><span class="idx">04</span> — Open source</div>
      <div>
        <h2>Public repositories</h2>
        <div class="grid-cards">
          {oss.map((item) => (
            <a href={`https://github.com/grandSeaFox/${item.repo}`} target="_blank" rel="noopener">
              <code>{item.repo}</code>
              <span class="small">{item.blurb}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="band">
      <div class="wrap row">
        <div class="label"><span class="idx">05</span> — Writing</div>
        <div>
          <h2>Latest posts</h2>
          <div class="posts">
            {posts.slice(0, 3).map((post) => (
              <article class="post">
                <div class="meta">{post.data.date.toISOString().slice(0, 10)}</div>
                <h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
                <p>{post.data.summary}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

  <section class="band">
    <div class="wrap row">
      <div class="label">Contact</div>
      <div>
        <h2>Get in touch</h2>
        <p>Open to interesting problems, particularly where product thinking and systems work meet.</p>
        <div class="facts">
          <span><b>goncalo.raposeiro@outlook.com</b></span>
        </div>
      </div>
    </div>
  </section>
</Base>
