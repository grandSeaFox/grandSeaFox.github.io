---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  // Policies hosted elsewhere get no page here; the index links straight out.
  const policies = await getCollection('privacy', (p) => !p.data.draft && !p.data.external);
  return policies.map((policy) => ({ params: { id: policy.id }, props: { policy } }));
}

const { policy } = Astro.props;
const { Content } = await render(policy);
---

<Base title={`${policy.data.app} privacy policy`} description={policy.data.summary} section="privacy">
  <section class="band">
    <div class="wrap row">
      <div class="label">
        <div>Last updated</div>
        <div style="margin-top:0.3rem">{policy.data.updated?.toISOString().slice(0, 10)}</div>
      </div>
      <div>
        <h2>{policy.data.app} privacy policy</h2>
        <p class="small">{policy.data.platforms.join(' · ')}</p>
        <div class="prose" style="margin-top:1.5rem"><Content /></div>
      </div>
    </div>
  </section>
</Base>
